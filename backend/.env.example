# ============================================================
# BIS Assistant - Environment Configuration Example
# ============================================================

# Application
PROJECT_NAME="BIS Assistant API"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Origins (JSON array of allowed frontend URLs)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# ------------------------------------------------------------
# Future Integration Placeholders (Not needed for foundation)
# ------------------------------------------------------------
# Groq (Query Understanding)
GROQ_API_KEY=
GROQ_MODEL="openai/gpt-oss-20b"

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL="gemini-1.5-flash"

# Supabase (PostgreSQL + pgvector Knowledge Base)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Embedding Model (Must match for ingestion and query retrieval, default: 384 dimensions)
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
RAG_TOP_K=5

# Sarvam AI (Indic Language processing)
SARVAM_API_KEY=

# viaSocket (Webhooks & Workflows)
VIASOCKET_WEBHOOK_URL=
VIASOCKET_API_KEY=
